# LLM Configuration
LLM_PROVIDER=fake # fake | groq

GROQ_API_KEY=your_groq_api_key_here
PLANNER_MODEL=openai/gpt-oss-120b
EXECUTOR_MODEL=openai/gpt-oss-120b
CHEAP_MODEL=openai/gpt-oss-20b

# Storage & Backend Configuration
STORAGE_BACKEND=local # local | supabase
CHECKPOINTER=sqlite   # sqlite | postgres

# Supabase Cloud Configuration (required when STORAGE_BACKEND=supabase or CHECKPOINTER=postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Portal & Service URLs
PORTAL_URL=http://localhost:3000
CRM_URL=http://localhost:8000

# Paths
CHECKPOINT_DB=data/runs.sqlite
DATA_DIR=./data
FEEDBACK_STORE=data/feedback_rules.json
